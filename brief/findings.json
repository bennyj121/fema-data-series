  "brief_findings": [
    {
      "id": 1,
      "title": "Declarations are area-rows, not events",
      "claim": "The declarations snapshot has 70,243 designated-area rows covering 5,244 unique disaster numbers, with declaration dates from 1953-05-02 through 2026-08-15."
    },
    {
      "id": 2,
      "title": "Common hazards are not where the Public Assistance dollars sit",
      "claim": "In 847,116 obligated PA project worksheets (declaration dates 1998-08-26 through 2026-06-30; $283,657,100,484.80 federal share obligated), severe-storm rows are 359,510 (42.4%) but 6.7% of federal dollars; tropical-cyclone rows are 263,916 (31.2%) and 49.1% of dollars; biological rows are 40,064 (4.7%) and 34.5% of dollars."
    },
    {
      "id": 3,
      "title": "A thin tail of worksheets holds most federal dollars",
      "claim": "3,315 of 847,116 worksheets (0.39%) have a federal share of $10 million or more and hold $187,685,022,892.07 (66.2%) of all federal share obligated. Officially Large projects are 119,424 of 847,116 rows (14.1%) and hold $266,298,601,198.25 (93.9%)."
    },
    {
      "id": 4,
      "title": "2020 declarations dominate the PA dollar total",
      "claim": "Disasters declared in calendar year 2020 account for 53,747 of 847,116 PA worksheets and $106,198,253,099.30 of $283,657,100,484.80 federal share obligated (37.4%). 40,053 of 40,064 biological PA rows were declared in 2020."
    },
    {
      "id": 5,
      "title": "Every PA disaster joins; most declarations have no obligated PA row here",
      "claim": "All 1,783 unique disaster numbers in the PA file appear in the declarations file. Only 1,783 of 3,648 unique declarations dated on or after 1998-08-26 (48.9%) have at least one obligated PA project in this snapshot. 1,766 PA-flagged declarations in that window have zero PA-file rows (source excludes pre-obligation projects)."
    }
  ]
}
